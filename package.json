{
  "name": "web-board-games",
  "version": "2.1.0",
  "description": "A multiplayer web-based board game platform on Cloudflare Workers + Durable Objects",
  "main": "src/worker.js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./styles/tailwind.css -o ./public_html/tailwind.css --minify",
    "dev": "npm run build:css && wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test \"test/*.test.js\"",
    "tail": "wrangler tail"
  },
  "keywords": [
    "games",
    "multiplayer",
    "cloudflare",
    "workers",
    "board-games",
    "durable-objects"
  ],
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.59.2"
  }
}
